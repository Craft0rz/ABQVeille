# AI Analysis - Required for AI-powered summaries
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Gmail API credentials (set after OAuth setup)
SENDER_EMAIL=your-email@gmail.com
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# Operator alert address for pipeline-health notices (AI outage / degradation).
# NOT the member list. Defaults to SENDER_EMAIL if unset.
# ALERT_EMAIL=operator@example.com

# External dead-man's-switch ping URL (healthchecks.io or compatible).
# The pipeline pings this on every run; if the service stops receiving pings
# it alerts you that the pipeline stopped running entirely. Empty = disabled.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Optional: Override defaults
# MIN_RELEVANCY_SCORE=0.3
# MAX_ARTICLES_PER_CATEGORY=10
# AI_MAX_ARTICLES=20
